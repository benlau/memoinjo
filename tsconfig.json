{
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "jsx": "react",
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "./src",
        "types": ["jest", "node"]
    }
}
